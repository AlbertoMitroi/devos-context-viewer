    "@tanstack/react-virtual": "3.10.9",
    "cytoscape": "3.30.4",
    "cytoscape-elk": "2.2.0",
    "cytoscape-fcose": "2.2.0",
    "cytoscape-svg": "0.4.0",
    "d3-hierarchy": "3.1.2",
    "marked": "14.1.4",
    "mermaid": "11.4.1",
    "react": "18.3.1",
